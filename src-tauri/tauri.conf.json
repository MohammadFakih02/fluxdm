{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxDM",
  "mainBinaryName": "FluxDM",
  "version": "2.2.0",
  "identifier": "com.moudi.fluxdm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FluxDM",
        "url": "index.html",
        "width": 1180,
        "height": 740,
        "minWidth": 420,
        "minHeight": 300,
        "center": true,
        "visible": false,
        "backgroundColor": "#191a1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: img: http://img.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FluxDM",
    "shortDescription": "Fast download manager — files, videos and torrents",
    "copyright": "FluxDM",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "fileAssociations": [
      { "ext": ["torrent"], "name": "FluxDM.torrent", "description": "BitTorrent file", "role": "Viewer" }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
